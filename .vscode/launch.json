{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Debug Django Tests",
			"type": "debugpy",
			"request": "launch",
			"purpose": ["debug-test"],
			"justMyCode": false,
			"console": "integratedTerminal",
			"env": {
				"DJANGO_SETTINGS_MODULE": "${workspaceFolder}/prop_house.settings"
			}
		},
		{
			"name": "Django: runserver",
			"type": "debugpy",
			"request": "launch",
			"program": "${workspaceFolder}/manage.py",
			"args": ["runserver", "8001"],
			"django": true,
			"justMyCode": true,
			"console": "integratedTerminal"
		},

		{
			"name": "Python Debugger: Django",
			"type": "debugpy",
			"request": "launch",
			"args": ["runserver"],
			"django": true,
			"autoStartBrowser": false,
			"program": "${workspaceFolder}/manage.py"
		}
	]
}
